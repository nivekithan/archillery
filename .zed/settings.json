{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "apps/web/**/routeTree.gen.ts",
  ],
  "languages": {
    "CSS": {
      "language_servers": ["!biome", "..."],
    },
    "JavaScript": {
      "language_servers": ["!biome", "..."],
    },
    "JSON": {
      "language_servers": ["!biome", "..."],
    },
    "JSONC": {
      "language_servers": ["!biome", "..."],
    },
    "TSX": {
      "language_servers": ["!biome", "..."],
    },
    "TypeScript": {
      "language_servers": ["!biome", "!typescript-language-server", "..."],
    },
  },
}
