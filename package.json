{
  "name": "git-cloudflare",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@git-cloudflare/git-metadata-service",
    "deploy": "turbo run deploy",
    "cf-typegen": "turbo run cf-typegen",
    "setup:typescript-go": "sh scripts/setup-typescript-go-repository.sh"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
