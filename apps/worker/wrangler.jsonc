{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "region": "aws:us-east-1"
  },
  "vars": {
    "GIT_USERNAME": "nivekithan"
  },
  "secrets": {
    "required": ["GIT_PASSWORD"]
  }
