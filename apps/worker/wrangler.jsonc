{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "placement": {
    "region": "aws:us-east-1",
  },
  "vars": {
    "GIT_USERNAME": "nivekithan",
    "ARCHIL_META_DISK": "dsk-00000000000642d2",
    "ARCHIL_REGION": "aws-us-east-1",
    "ARCHIL_SANDBOX_IMAGE": "ghcr.io/nivekithan/archillery@sha256:40902927766152311cf2a6436b2b177e335a04a0dafb9bdf72079d1f15a62c03",
    "GIT_IDLE_TIMEOUT_SECONDS": 900,
  },
  "secrets": {
    "required": ["GIT_PASSWORD", "ARCHIL_API_KEY"],
  },
  "queues": {
    "producers": [
      {
        "binding": "SANDBOX_QUEUE",
        "queue": "git-cloudflare-sandbox-prewarm",
      },
    ],
    "consumers": [
      {
        "queue": "git-cloudflare-sandbox-prewarm",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GIT_REPOSITORY",
        "class_name": "GitRepository",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GitRepository"],
      "deleted_classes": ["GitContainer"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["GitContainer"],
      "deleted_classes": ["GitRepository"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["GitRepository"],
      "deleted_classes": ["GitContainer"],
    },
  ],
}
