{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "placement": {
    "region": "aws:us-east-1",
  },
  "vars": {
    "GIT_USERNAME": "nivekithan",
    "ARCHIL_REGION": "aws-us-east-1",
    "GIT_IDLE_TIMEOUT_SECONDS": 900,
  },
  "secrets": {
    "required": ["GIT_PASSWORD", "ARCHIL_API_KEY"],
  },
  "queues": {
    "producers": [
      {
        "binding": "SANDBOX_QUEUE",
        "queue": "git-cloudflare-sandbox-prewarm",
      },
    ],
    "consumers": [
      {
        "queue": "git-cloudflare-sandbox-prewarm",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
      },
    ],
  },
  "containers": [
    {
      "class_name": "RepositoryContainer",
      "image": "../container/Dockerfile",
      "name": "git-cloudflare-repository-runtime",
      "image_build_context": "../..",
      "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 12000 },
      "max_instances": 10,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GIT_REPOSITORY",
        "class_name": "RepositoryContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GitRepository"],
      "deleted_classes": ["GitContainer"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["GitContainer"],
      "deleted_classes": ["GitRepository"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["GitRepository"],
      "deleted_classes": ["GitContainer"],
    },
    { "tag": "v5", "new_sqlite_classes": ["RepositoryContainer"] },
    { "tag": "v6", "deleted_classes": ["RepositoryContainer"] },
    {
      "tag": "v7",
      "renamed_classes": [
        { "from": "GitRepository", "to": "RepositoryContainer" },
      ],
    },
  ],
}
