{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-cloudflare-web",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "services": [
    {
      "binding": "GIT_WORKER",
      "service": "git-cloudflare",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "placement": {
    "region": "aws:us-east-1",
  },
  "routes": [
    {
      "pattern": "git.nivekithan.com",
      "custom_domain": true,
    },
  ],
}
